{
  "name": "elaborados-client",
  "version": "1.1.1",
  "main": ".vite/build/index.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run && node scripts/test-node.cjs --serial",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "node -e \"require('child_process').execSync('npx prebuild-install --runtime node --target ' + process.version.slice(1), {stdio:'inherit'})\""
  },
  "dependencies": {
    "@core/db": "workspace:*",
    "@core/main": "workspace:*",
    "@core/preload": "workspace:*",
    "@core/ui": "workspace:*",
    "@ferreteria/shared": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.38.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/plugin-vite": "^7.7.0",
    "@electron-forge/shared-types": "^7.7.0",
    "@electron/rebuild": "^4.0.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.29.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
