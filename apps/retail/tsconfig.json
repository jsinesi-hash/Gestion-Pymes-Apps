{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "@ferreteria/shared": ["../../packages/shared/src/index.ts"],
      "@core/db": ["../../packages/core-db/src/index.ts"],
      "@core/ui": ["../../packages/core-ui/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "forge.config.ts",
    "vite*.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "out", ".vite"]
}
