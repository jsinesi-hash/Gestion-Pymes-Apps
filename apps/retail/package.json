{
  "name": "ferreteria-client",
  "version": "1.1.1",
  "main": ".vite/build/index.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "dist": "node scripts/dist.cjs",
    "dist:full": "pnpm rebuild:electron && pnpm dist",
    "release": "node scripts/dist.cjs --publish always",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run && node scripts/test-node.cjs",
    "seed:base": "node scripts/seed-base.cjs",
    "seed:dev": "node scripts/seed-dev.cjs",
    "seed:geo": "node scripts/seed-geo.cjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "node -e \"require('child_process').execSync('npx prebuild-install --runtime node --target ' + process.version.slice(1), {stdio:'inherit'})\""
  },
  "dependencies": {
    "@core/db": "workspace:*",
    "@core/main": "workspace:*",
    "@core/ui": "workspace:*",
    "@ferreteria/shared": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.38.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/plugin-vite": "^7.7.0",
    "@electron-forge/shared-types": "^7.7.0",
    "@electron/rebuild": "^4.0.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "app-builder-bin": "file:..\\..\\docs\\app-builder-bin-5.0.0-alpha.10.tgz",
    "drizzle-kit": "^0.29.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
