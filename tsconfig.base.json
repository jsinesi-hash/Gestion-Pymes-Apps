{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@ferreteria/shared": ["./packages/shared/src/index.ts"],
      "@core/db": ["./packages/core-db/src/index.ts"],
      "@core/ui": ["./packages/core-ui/src/index.ts"],
      "@core/main": ["./packages/core-main/src/index.ts"],
      "@core/preload": ["./packages/core-preload/src/index.ts"]
    }
  }
}
